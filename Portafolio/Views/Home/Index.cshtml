@model Portafolio.Models.PortfolioViewModel
@{
    ViewData["Title"] = "Portafolio — Juan Karlos";
}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="hero-section" id="hero">
    <p class="hero-tag">Full Stack Developer</p>

    <h1 class="hero-title">
        Hola, soy
        <span class="name-highlight">Juan Karlos.</span>
    </h1>

    <p class="hero-subtitle">@Model.Description</p>

    <div class="hero-cta">
        <a href="#projects" class="btn-primary">
            Ver proyectos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#contact" class="btn-secondary">Contáctame</a>
    </div>

    <div class="hero-stats">
        <div class="stat-item">
            <p class="stat-number">3<span>+</span></p>
            <p class="stat-label">Años de código</p>
        </div>
        <div class="stat-item">
            <p class="stat-number">10<span>+</span></p>
            <p class="stat-label">Proyectos</p>
        </div>
        <div class="stat-item">
            <p class="stat-number">3<span>+</span></p>
            <p class="stat-label">Tecnologías</p>
        </div>
    </div>

    <div class="hero-scroll">
        <span class="scroll-line"></span>
        Scroll
    </div>
</section>

<div class="section-divider"></div>

<!-- ============================================================
     ABOUT
     ============================================================ -->
<section class="section" id="about">
    <div class="section-header observe">
        <p class="section-tag"><span class="tag-num">[01]</span> Sobre mí</p>
        <h2 class="section-title">Construyo cosas que<br><em>importan.</em></h2>
    </div>

    <div class="about-grid">
        <div class="about-text observe observe-delay-1">
            <p>
                Soy <strong>Juan Karlos Morales Paladino</strong>, desarrollador Full Stack estudiante de
                Ingeniería en Sistemas en la <strong>UNAN Managua</strong>. Me apasiona crear soluciones
                tecnológicas que sean tanto funcionales como estéticamente impecables.
            </p>
            <p>
                Tengo experiencia construyendo <strong>APIs REST con .NET</strong>, aplicaciones móviles
                multiplataforma con <strong>Flutter y Dart</strong>, y frontends modernos con
                <strong>HTML, CSS y JavaScript</strong>.
            </p>
            <p>
                Creo que el buen código no solo resuelve problemas — también cuenta una historia. Cada
                proyecto es una oportunidad de aprender, crecer y entregar algo que supere expectativas.
            </p>

            <div class="about-tags">
                <span class="about-tag">.NET Web API</span>
                <span class="about-tag">Flutter</span>
                <span class="about-tag">Dart</span>
                <span class="about-tag">HTML</span>
                <span class="about-tag">CSS</span>
                <span class="about-tag">JavaScript</span>
                <span class="about-tag">C#</span>
                <span class="about-tag">SQL Server</span>
            </div>
        </div>

        <div class="about-visual observe observe-delay-2">
            <div class="about-card">
                <span class="about-card-icon">🚀</span>
                <h3>Enfocado en resultados</h3>
                <p>No solo escribo código — entrego soluciones completas, desde el backend hasta la interfaz de usuario, listas para producción.</p>

                <div class="about-card-grid">
                    <div class="mini-card">
                        <span class="mini-num">100%</span>
                        <span class="mini-label">Dedicación</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-num">∞</span>
                        <span class="mini-label">Curiosidad</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-num">3</span>
                        <span class="mini-label">Stacks</span>
                    </div>
                    <div class="mini-card">
                        <span class="mini-num">24/7</span>
                        <span class="mini-label">Aprendizaje</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="section-divider"></div>

<!-- ============================================================
     SKILLS
     ============================================================ -->
<div class="skills-bg" id="skills">
    <div class="section" style="padding-top:0; padding-bottom:0;">
        <div class="section-header observe">
            <p class="section-tag"><span class="tag-num">[02]</span> Stack Tecnológico</p>
            <h2 class="section-title">Mis <em>herramientas</em><br>de trabajo.</h2>
        </div>
    </div>

    <div class="skills-grid">
        @{ int skillIdx = 0; }
        @foreach (var skill in Model.Skills)
        {
            <div class="skill-card observe observe-delay-@((skillIdx % 4) + 1)">
                <span class="skill-icon">@skill.Icon</span>
                <h3 class="skill-category">@skill.Category</h3>
                <ul class="skill-list">
                    @foreach (var tech in skill.Technologies)
                    {
                        <li>@tech</li>
                    }
                </ul>
            </div>
            skillIdx++;
        }
    </div>
</div>

<div class="section-divider"></div>

<!-- ============================================================
     PROJECTS
     ============================================================ -->
<section class="section" id="projects">
    <div class="section-header observe">
        <p class="section-tag"><span class="tag-num">[03]</span> Proyectos</p>
        <h2 class="section-title">Lo que he<br><em>construido.</em></h2>
    </div>

    <div class="projects-grid">
        @{ int projIdx = 0; }
        @foreach (var project in Model.Projects)
        {
            <article class="project-card observe observe-delay-@((projIdx % 4) + 1)">
                <div class="project-header">
                    <span class="project-tag">@project.Tag</span>
                    <span class="project-year">@project.Year</span>
                </div>
                <h3 class="project-title">@project.Title</h3>
                <p class="project-desc">@project.Description</p>
                <p class="project-tech">@project.Tech</p>
            </article>
            projIdx++;
        }
    </div>
</section>

<div class="section-divider"></div>

<!-- ============================================================
     EXPERIENCE
     ============================================================ -->
<div class="experience-bg" id="experience">
    <div class="section" style="padding-top:0; padding-bottom:0;">
        <div class="section-header observe">
            <p class="section-tag"><span class="tag-num">[04]</span> Experiencia</p>
            <h2 class="section-title">Mi <em>trayectoria.</em></h2>
        </div>
    </div>

    <div class="experience-list">
        @{ int expIdx = 0; }
        @foreach (var exp in Model.Experiences)
        {
            <div class="experience-item observe observe-delay-@((expIdx % 3) + 1)">
                <div class="exp-left">
                    <p class="exp-period">@exp.Period</p>
                    <p class="exp-company">@exp.Company</p>
                </div>
                <div class="exp-right">
                    <h3 class="exp-role">@exp.Role</h3>
                    <p class="exp-desc">@exp.Description</p>
                </div>
            </div>
            expIdx++;
        }
    </div>
</div>

<div class="section-divider"></div>

<!-- ============================================================
     CONTACT
     ============================================================ -->
<section class="section" id="contact">
    <div class="contact-wrapper observe">
        <p class="section-tag" style="justify-content:center;"><span class="tag-num">[05]</span> Contacto</p>
        <h2 class="contact-big">¿Trabajamos<br><span>juntos?</span></h2>
        <p class="contact-sub">
            Estoy abierto a nuevas oportunidades, proyectos freelance y colaboraciones.
            Si tienes una idea, un proyecto o simplemente quieres hablar de tecnología — escríbeme.
        </p>

        <div class="contact-links">
            <a href="mailto:@Model.Email" class="contact-link primary" id="email-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                @Model.Email
            </a>
            <a href="@Model.GitHub" target="_blank" rel="noopener" class="contact-link ghost" id="github-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                GitHub
            </a>
            <a href="@Model.LinkedIn" target="_blank" rel="noopener" class="contact-link ghost" id="linkedin-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
            </a>
        </div>
    </div>
</section>
