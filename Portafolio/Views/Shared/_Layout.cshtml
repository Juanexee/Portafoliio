<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de Juan Karlos Morales Paladino — Full Stack Developer especializado en .NET, Flutter y desarrollo web." />
    <title>@ViewData["Title"] — Juan Karlos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
</head>
<body>

    <!-- Navigation -->
    <nav class="nav-bar" id="navbar">
        <div class="nav-container">
            <a href="#hero" class="nav-logo">
                <svg class="logo-icon" width="28" height="28" viewBox="0 0 28 28" fill="none">
                    <line x1="14" y1="2" x2="14" y2="26" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="2" y1="14" x2="26" y2="14" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="5.17" y1="5.17" x2="22.83" y2="22.83" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="22.83" y1="5.17" x2="5.17" y2="22.83" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span>Juan Karlos Morales Paladino</span>
            </a>

            <ul class="nav-links" id="navLinks">
                <li><a href="#about" class="nav-link" data-section="about">Sobre mí</a></li>
                <li><a href="#skills" class="nav-link" data-section="skills">Skills</a></li>
                <li><a href="#projects" class="nav-link" data-section="projects">Proyectos</a></li>
                <li><a href="#experience" class="nav-link" data-section="experience">Experiencia</a></li>
                <li><a href="#contact" class="nav-link" data-section="contact">Contacto</a></li>
            </ul>

            <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-section">
        <div class="footer-inner">
            <div class="footer-logo">
                <svg width="24" height="24" viewBox="0 0 28 28" fill="none">
                    <line x1="14" y1="2" x2="14" y2="26" stroke="#E85002" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="2" y1="14" x2="26" y2="14" stroke="#E85002" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="5.17" y1="5.17" x2="22.83" y2="22.83" stroke="#E85002" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="22.83" y1="5.17" x2="5.17" y2="22.83" stroke="#E85002" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span>Juan Karlos Morales Paladino</span>
            </div>
            <p class="footer-copy">&copy; 2026 — Full Stack Developer · Hecho con código y ☕</p>
        </div>
    </footer>

    <script src="~/js/portfolio.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
